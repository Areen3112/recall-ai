# Application
APP_ENV=development
SECRET_KEY=your_secret_key_here
FRONTEND_URL=http://localhost:5173

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_CONTEXT_BUDGET_BYTES=8192

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Hindsight
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID_SECRET=your_hindsight_bank_id_secret_here

# Signed widget identity token verification
IDENTITY_TOKEN_SECRET=your_identity_token_secret_here
IDENTITY_TOKEN_MAX_TTL_SECONDS=3600
IDENTITY_TOKEN_ISSUER=recall-ai-business-backend
IDENTITY_TOKEN_AUDIENCE=recall-ai-chat

# Optional Sarah demo seeder guard. Set only for an isolated demo project.
ALLOW_SYNTHETIC_DEMO_SEED=false
DEMO_SUPABASE_PROJECT_REF=
DEMO_SUPABASE_PROJECT_ALLOWLIST=
